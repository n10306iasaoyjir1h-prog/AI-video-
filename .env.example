# YouTube OAuth Web application credentials
# Keep this file as a template. Put real values in your shell environment or a local .env file that is not committed.
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
# Google Cloud Consoleに登録するURI。localhostで開く場合は末尾の / まで一致させる。
YOUTUBE_REDIRECT_URI=http://localhost:4173/oauth2callback
# falseなら上記URIを固定使用。VS Code転送URLを使う時だけtrueにする。
YOUTUBE_DYNAMIC_REDIRECT=false

# Irodori TTS Gradio URL
IRODORI_URL=http://localhost:7860
# Gradio API name shown in Irodori's "View API" panel, for example predict
IRODORI_API_NAME=predict

# Storyline web app
PORT=4173
