# STORYLINE local integration configuration
PORT=4173
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
IRODORI_URL=http://localhost:7860
IRODORI_API_NAME=
DISCORD_WEBHOOK_URL=

# Notion is the canonical project database
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_API_VERSION=2022-06-28

# n8n webhook endpoint
N8N_BASE_URL=http://localhost:5678
N8N_STORYLINE_WEBHOOK=/webhook/storyline-job
N8N_WEBHOOK_SECRET=

# GitHub Actions dispatch
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ACTIONS_TOKEN=
GITHUB_RENDER_WORKFLOW=render-remotion.yml

# Kaggle GPU worker dispatch
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_SLUG=
KAGGLE_DATASET_SLUG=
KAGGLE_GPU_ENABLED=true

# Optional local services. Leave disabled until installed.
REMOTION_ENABLED=false
LIVEPORTRAIT_ENABLED=false
SADTALKER_ENABLED=false
LIVEPORTRAIT_URL=
SADTALKER_URL=
